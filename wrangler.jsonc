{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hinsdale-house",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "INQUIRY_EMAIL",
      "destination_address": "122.hinsdale@gmail.com"
    }
  ]
}
