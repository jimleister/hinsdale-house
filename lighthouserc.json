{
  "ci": {
    "collect": {
      "staticDistDir": "./public",
      "settings": {
        "chromeFlags": "--no-sandbox --disable-setuid-sandbox --disable-dev-shm-usage"
      },
      "url": [
        "http://localhost/",
        "http://localhost/magnolia/",
        "http://localhost/dogwood/",
        "http://localhost/loblolly/",
        "http://localhost/hatteras/",
        "http://localhost/fort-bragg-furnished-housing/",
        "http://localhost/travel-nurse-housing-fayetteville-nc/",
        "http://localhost/corporate-housing-fayetteville-nc/",
        "http://localhost/fayetteville-relocation-guide/",
        "http://localhost/fayetteville-guide/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
